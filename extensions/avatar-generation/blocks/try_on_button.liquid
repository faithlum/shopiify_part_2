<div class="try-on-container">
  <button 
    class="try-on-button" 
    onclick="showTryOnModal()"
    style="
      background: {{ block.settings.button_color }};
      color: {{ block.settings.text_color }};
      padding: 10px 20px;
      border: none;
      cursor: pointer;
      width: 100%;
      margin: 10px 0;
    "
  >
    {{ block.settings.button_text }} ›
  </button>
</div>

<style>
  .modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(0,0,0,0.5);
    z-index: 9999;
    display: none;
  }

  .modal-content {
    background-color: white;
    margin: 15% auto;
    padding: 20px;
    width: 80%;
    max-width: 500px;
    border-radius: 8px;
    position: relative;
  }

  .close {
    position: absolute;
    right: 20px;
    top: 10px;
    font-size: 28px;
    cursor: pointer;
  }

  .back-button {
    position: absolute;
    left: 20px;
    top: 10px;
    font-size: 28px;
    background: none;
    border: none;
    cursor: pointer;
  }

  .user-option {
    border: 1px solid #ddd;
    padding: 20px;
    margin: 10px 0;
    border-radius: 4px;
    cursor: pointer;
  }

  .user-option:hover {
    background-color: #f5f5f5;
  }

  .small-text {
    font-size: 0.9em;
    color: #666;
  }

  .upload-area {
    text-align: center;
    padding: 20px;
  }

  .upload-placeholder {
    width: 200px;
    height: 200px;
    margin: 0 auto 20px;
    background: #f5f5f5;
    border: 2px dashed #ddd;
  }

  h2 {
    text-align: center;
    margin-bottom: 20px;
  }

  h3 {
    margin: 10px 0;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    // Create modals HTML
    const modalsHTML = `
      <!-- User Type Modal -->
      <div id="userTypeModal" class="modal">
        <div class="modal-content">
          <span class="close" onclick="closeModal('userTypeModal')">&times;</span>
          
          <h2>First-Time User</h2>
          <div class="user-option" onclick="showQRCode()">
            <p>New here? Start here by scanning your body to create your avatar.</p>
          </div>

          <h2>Returning User</h2>
          <div class="user-option" onclick="showUploadAvatar()">
            <p>If you've already scanned with us, let's get your avatar ready for try-on.</p>
          </div>
        </div>
      </div>

      <!-- QR Code Modal -->
      <div id="qrCodeModal" class="modal">
        <div class="modal-content">
          <div class="modal-header">
            <button onclick="backToUserType('qrCodeModal')" class="back-button">←</button>
            <span class="close" onclick="closeModal('qrCodeModal')">&times;</span>
          </div>
          
          <h2>START HERE</h2>
          <img src="{{ 'qr-code.png' | asset_url }}" alt="QR Code" style="width: 200px; height: 200px;">
          <p>Scan QR Code</p>
          <p class="small-text">Follow the on-screen steps on your phone, then switch back to your laptop to try on the clothing.</p>
        </div>
      </div>

      <!-- Upload Avatar Modal -->
      <div id="uploadAvatarModal" class="modal">
        <div class="modal-content">
          <div class="modal-header">
            <button onclick="backToUserType('uploadAvatarModal')" class="back-button">←</button>
            <span class="close" onclick="closeModal('uploadAvatarModal')">&times;</span>
          </div>
          
          <h2>WELCOME BACK</h2>
          <div class="upload-area">
            <div class="upload-placeholder"></div>
            <h3>Upload your avatar</h3>
            <p class="small-text">Upload your avatar file (FBX format only).</p>
          </div>
        </div>
      </div>
    `;

    // Insert modals into body
    document.body.insertAdjacentHTML('beforeend', modalsHTML);
  });

  function showTryOnModal() {
    document.getElementById('userTypeModal').style.display = 'block';
  }

  function showQRCode() {
    document.getElementById('userTypeModal').style.display = 'none';
    document.getElementById('qrCodeModal').style.display = 'block';
  }

  function showUploadAvatar() {
    document.getElementById('userTypeModal').style.display = 'none';
    document.getElementById('uploadAvatarModal').style.display = 'block';
  }

  function backToUserType(currentModalId) {
    document.getElementById(currentModalId).style.display = 'none';
    document.getElementById('userTypeModal').style.display = 'block';
  }

  function closeModal(modalId) {
    document.getElementById(modalId).style.display = 'none';
  }

  // Close modal when clicking outside
  window.onclick = function(event) {
    if (event.target.className === 'modal') {
      event.target.style.display = 'none';
    }
  }
</script>

{% schema %}
{
  "name": "Try On Button",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Try-on and find your size"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    }
  ]
}
{% endschema %} 