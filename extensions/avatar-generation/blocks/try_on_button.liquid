<div class="try-on-container" style="--button-color: {{ block.settings.button_color }}; --text-color: {{ block.settings.text_color }};">
  <button 
    class="try-on-button custom-try-on-button" 
    onclick="showTryOnModal()"
  >
    {{ block.settings.button_text }} ›
  </button>
</div>

<style>
  .modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(0,0,0,0.5);
    z-index: 9999;
    display: none;
  }

  .modal-content {
    background-color: white;
    margin: 15% auto;
    padding: 20px;
    width: 80%;
    max-width: 500px;
    border-radius: 8px;
    position: relative;
  }

  .close {
    position: absolute;
    right: 20px;
    top: 10px;
    font-size: 28px;
    cursor: pointer;
  }

  .back-button {
    position: absolute;
    left: 20px;
    top: 10px;
    font-size: 28px;
    background: none;
    border: none;
    cursor: pointer;
  }

  .user-option {
    border: 1px solid #ddd;
    padding: 20px;
    margin: 10px 0;
    border-radius: 4px;
    cursor: pointer;
  }

  .user-option:hover {
    background-color: #f5f5f5;
  }

  .small-text {
    font-size: 0.9em;
    color: #666;
  }

  .upload-area {
    text-align: center;
    padding: 20px;
  }

  .upload-placeholder {
    width: 200px;
    height: 200px;
    margin: 0 auto 20px;
    background: #f5f5f5;
    border: 2px dashed #ddd;
  }

  h2 {
    text-align: center;
    margin-bottom: 20px;
  }

  h3 {
    margin: 10px 0;
  }

  .custom-try-on-button {
    background: var(--button-color);
    color: var(--text-color);
    padding: 10px 20px;
    border: none;
    cursor: pointer;
    width: 100%;
    margin: 10px 0;
  }

  /* Add these new styles for the upload button */
  #uploadButton {
    width: 100%;
    background: #000;
    color: white;
    padding: 16px;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    cursor: pointer;
  }

  #uploadButton:disabled {
    opacity: 0.5;
  }
</style>

<script>
  // Add this at the very top of your script section
  const originalConsoleWarn = console.warn;
  const warningsSeen = new Set();
  console.warn = function(...args) {
    const message = args[0];
    if (typeof message === 'string' && message.includes('third-party cookies')) {
      if (!warningsSeen.has(message)) {
        warningsSeen.add(message);
        originalConsoleWarn.apply(console, args);
      }
      return;
    }
    originalConsoleWarn.apply(console, args);
  };

  document.addEventListener("DOMContentLoaded", function() {
    // Create modals HTML
    const modalsHTML = `
      <!-- User Type Modal -->
      <div id="userTypeModal" class="modal">
        <div class="modal-content">
          <span class="close" onclick="closeModal('userTypeModal')">&times;</span>
          
          <div style="padding: 20px;">
            <h2 style="
              font-size: 28px;
              text-align: center;
              margin-bottom: 30px;
              font-weight: normal;
            ">DISCOVER YOUR PERFECT FIT</h2>
            
          <img src="{{ 'tailor_measuring.png' | asset_img_url }}" 
            alt="Tailor measuring" 
            style="
              width: 100%;
              max-width: 300px;
              height: auto;
              margin: 20px auto;
              display: block;
            "
          >
            
            <p style="
              text-align: center;
              font-size: 16px;
              line-height: 1.5;
              margin: 20px 0 30px;
            ">Create your custom avatar and find your perfect size using just your phone camera.</p>

            <button onclick="showQRCode()" 
              style="
                width: 100%;
                background: #000;
                color: white;
                padding: 16px;
                border: none;
                border-radius: 8px;
                font-size: 16px;
                cursor: pointer;
                margin-bottom: 20px;
              "
            >Get Started</button>

            <div style="text-align: center;">
              <a href="#" 
                style="
                  color: #000;
                  text-decoration: underline;
                  font-size: 14px;
                "
              >Already scanned?</a>
            </div>
          </div>
        </div>
      </div>

      <!-- QR Code Modal -->
      <div id="qrCodeModal" class="modal">
        <div class="modal-content">
          <div class="modal-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
            <button onclick="backToUserType('qrCodeModal')" class="back-button" style="
              font-size: 24px;
              background: none;
              border: none;
              cursor: pointer;
            ">←</button>
            <button onclick="closeModal('qrCodeModal')" class="close" style="
              font-size: 24px;
              background: none;
              border: none;
              cursor: pointer;
            ">×</button>
          </div>
          
          <div style="text-align: center; padding: 20px;">
            <h2 style="
              font-size: 24px;
              margin-bottom: 40px;
              font-weight: normal;
            ">SCAN QR CODE</h2>

            <img src="{{ 'qr_code.png' | asset_img_url }}" 
              alt="QR Code" 
              style="
                width: 280px;
                height: 280px;
                margin: 0 auto 40px;
                display: block;
              "
            >

            <p style="
              text-align: center;
              font-size: 16px;
              line-height: 1.5;
              margin-bottom: 40px;
              color: #333;
            ">Follow the on-screen steps on your phone, then switch back to your laptop to try on the clothing.</p>

            <button onclick="showUploadAvatar()"
              style="
                width: 100%;
                background: #000;
                color: white;
                padding: 16px;
                border: none;
                border-radius: 8px;
                font-size: 16px;
                cursor: pointer;
              "
            >Done Scanning</button>
          </div>
        </div>
      </div>
    `;

    // Insert modals into body
    document.body.insertAdjacentHTML('beforeend', modalsHTML);
  });

  function showTryOnModal() {
    document.getElementById('userTypeModal').style.display = 'block';
  }

  function showQRCode() {
    document.getElementById('userTypeModal').style.display = 'none';
    document.getElementById('qrCodeModal').style.display = 'block';
  }

  function showUploadAvatar() {
    // Placeholder for future functionality
    console.log('Upload avatar functionality coming soon');
  }

  function backToUserType(currentModalId) {
    document.getElementById(currentModalId).style.display = 'none';
    document.getElementById('userTypeModal').style.display = 'block';
  }

  function closeModal(modalId) {
    document.getElementById(modalId).style.display = 'none';
  }

  // Close modal when clicking outside
  window.onclick = function(event) {
    if (event.target.className === 'modal') {
      event.target.style.display = 'none';
    }
  }
</script>

{% schema %}
{
  "name": "Try On Button",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Try-on and find your size"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    }
  ]
}
{% endschema %} 