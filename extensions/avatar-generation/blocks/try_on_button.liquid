<div class="try-on-container" style="--button-color: {{ block.settings.button_color }}; --text-color: {{ block.settings.text_color }};">
  <button 
    class="try-on-button custom-try-on-button" 
    onclick="showTryOnModal()"
  >
    {{ block.settings.button_text }} ›
  </button>
</div>

<style>
  .modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(0,0,0,0.5);
    z-index: 9999;
    display: none;
  }

  .modal-content {
    background-color: white;
    margin: 15% auto;
    padding: 20px;
    width: 80%;
    max-width: 500px;
    border-radius: 8px;
    position: relative;
  }

  .close {
    position: absolute;
    right: 20px;
    top: 10px;
    font-size: 28px;
    cursor: pointer;
  }

  .back-button {
    position: absolute;
    left: 20px;
    top: 10px;
    font-size: 28px;
    background: none;
    border: none;
    cursor: pointer;
  }

  .user-option {
    border: 1px solid #ddd;
    padding: 20px;
    margin: 10px 0;
    border-radius: 4px;
    cursor: pointer;
  }

  .user-option:hover {
    background-color: #f5f5f5;
  }

  .small-text {
    font-size: 0.9em;
    color: #666;
  }

  .upload-area {
    text-align: center;
    padding: 20px;
  }

  .upload-placeholder {
    width: 200px;
    height: 200px;
    margin: 0 auto 20px;
    background: #f5f5f5;
    border: 2px dashed #ddd;
  }

  h2 {
    text-align: center;
    margin-bottom: 20px;
  }

  h3 {
    margin: 10px 0;
  }

  .custom-try-on-button {
    background: var(--button-color);
    color: var(--text-color);
    padding: 10px 20px;
    border: none;
    cursor: pointer;
    width: 100%;
    margin: 10px 0;
  }

  /* Add these new styles for the upload button */
  #uploadButton {
    width: 100%;
    background: #000;
    color: white;
    padding: 16px;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    cursor: pointer;
  }

  #uploadButton:disabled {
    opacity: 0.5;
  }
</style>

<script>
  // Add this at the very top of your script section
  const originalConsoleWarn = console.warn;
  const warningsSeen = new Set();
  console.warn = function(...args) {
    const message = args[0];
    if (typeof message === 'string' && message.includes('third-party cookies')) {
      if (!warningsSeen.has(message)) {
        warningsSeen.add(message);
        originalConsoleWarn.apply(console, args);
      }
      return;
    }
    originalConsoleWarn.apply(console, args);
  };

  document.addEventListener("DOMContentLoaded", function() {
    // Create modals HTML
    const modalsHTML = `
      <!-- User Type Modal -->
      <div id="userTypeModal" class="modal">
        <div class="modal-content">
          <span class="close" onclick="closeModal('userTypeModal')">&times;</span>
          
          <div style="padding: 20px;">
            <h2 style="
              font-size: 28px;
              text-align: center;
              margin-bottom: 30px;
              font-weight: normal;
            ">DISCOVER YOUR PERFECT FIT</h2>
            
          <img src="{{ 'tailor_measuring.png' | asset_img_url }}" 
            alt="Tailor measuring" 
            style="
              width: 100%;
              max-width: 300px;
              height: auto;
              margin: 20px auto;
              display: block;
            "
          >
            
            <p style="
              text-align: center;
              font-size: 16px;
              line-height: 1.5;
              margin: 20px 0 30px;
            ">Create your custom avatar and find your perfect size using just your phone camera.</p>

            <button onclick="showQRCode()" 
              style="
                width: 100%;
                background: #000;
                color: white;
                padding: 16px;
                border: none;
                border-radius: 8px;
                font-size: 16px;
                cursor: pointer;
                margin-bottom: 20px;
              "
            >Get Started</button>

            <div style="text-align: center;">
              <a href="#" 
                style="
                  color: #000;
                  text-decoration: underline;
                  font-size: 14px;
                "
              >Already scanned?</a>
            </div>
          </div>
        </div>
      </div>

      <!-- QR Code Modal -->
      <div id="qrCodeModal" class="modal">
        <div class="modal-content">
          <div class="modal-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
            <button onclick="backToUserType('qrCodeModal')" class="back-button" style="
              font-size: 24px;
              background: none;
              border: none;
              cursor: pointer;
            ">←</button>
            <button onclick="closeModal('qrCodeModal')" class="close" style="
              font-size: 24px;
              background: none;
              border: none;
              cursor: pointer;
            ">×</button>
          </div>
          
          <div style="text-align: center; padding: 20px;">
            <h2 style="
              font-size: 24px;
              margin-bottom: 40px;
              font-weight: normal;
            ">SCAN QR CODE</h2>

            <img src="{{ 'qr_code.png' | asset_img_url }}" 
              alt="QR Code" 
              style="
                width: 280px;
                height: 280px;
                margin: 0 auto 40px;
                display: block;
              "
            >

            <p style="
              text-align: center;
              font-size: 16px;
              line-height: 1.5;
              margin-bottom: 40px;
              color: #333;
            ">Follow the on-screen steps on your phone, then switch back to your laptop to try on the clothing.</p>

            <button onclick="showUploadAvatar()"
              style="
                width: 100%;
                background: #000;
                color: white;
                padding: 16px;
                border: none;
                border-radius: 8px;
                font-size: 16px;
                cursor: pointer;
              "
            >Done Scanning</button>
          </div>
        </div>
      </div>

      <!-- Upload Avatar Modal -->
      <div id="uploadAvatarModal" class="modal">
        <div class="modal-content">
          <div class="modal-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
            <button onclick="backToUserType('uploadAvatarModal')" class="back-button" style="
              font-size: 24px;
              background: none;
              border: none;
              cursor: pointer;
            ">←</button>
            <button onclick="closeModal('uploadAvatarModal')" class="close" style="
              font-size: 24px;
              background: none;
              border: none;
              cursor: pointer;
            ">×</button>
          </div>
          
          <div style="text-align: center; padding: 20px;">
            <h2 style="
              font-size: 24px;
              margin-bottom: 40px;
              font-weight: normal;
            ">UPLOAD YOUR AVATAR</h2>

            <div style="
              width: 280px;
              height: 280px;
              margin: 0 auto 40px;
              border: 2px dashed #ddd;
              border-radius: 8px;
              display: flex;
              flex-direction: column;
              align-items: center;
              justify-content: center;
              background: #f9f9f9;
            ">
              <input type="file" 
                id="avatarFile" 
                accept=".fbx"
                style="display: none;"
                onchange="handleFileSelect(this)"
              >
              <div id="uploadPlaceholder" style="cursor: pointer;" onclick="document.getElementById('avatarFile').click()">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                  <polyline points="17 8 12 3 7 8"/>
                  <line x1="12" y1="3" x2="12" y2="15"/>
                </svg>
                <p style="
                  margin-top: 15px;
                  color: #666;
                  font-size: 14px;
                ">Click to upload your avatar file<br>(FBX format only)</p>
              </div>
              <div id="filePreview" style="display: none;">
                <p style="color: #333; margin-bottom: 10px;"></p>
              </div>
            </div>

            <button id="uploadButton"
              onclick="uploadAvatar()"
              style="
                width: 100%;
                background: #000;
                color: white;
                padding: 16px;
                border: none;
                border-radius: 8px;
                font-size: 16px;
                cursor: pointer;
                opacity: 0.5;
              "
              disabled
            >Upload</button>
          </div>
        </div>
      </div>
    `;

    // Insert modals into body
    document.body.insertAdjacentHTML('beforeend', modalsHTML);
  });

  function showTryOnModal() {
    document.getElementById('userTypeModal').style.display = 'block';
  }

  function showQRCode() {
    document.getElementById('userTypeModal').style.display = 'none';
    document.getElementById('qrCodeModal').style.display = 'block';
  }

  function showUploadAvatar() {
    document.getElementById('qrCodeModal').style.display = 'none';
    document.getElementById('uploadAvatarModal').style.display = 'block';
    
    // Reset all upload-related elements
    const fileInput = document.getElementById('avatarFile');
    const uploadButton = document.getElementById('uploadButton');
    const preview = document.getElementById('filePreview');
    const placeholder = document.getElementById('uploadPlaceholder');
    
    // Reset file input
    if (fileInput) {
      fileInput.value = '';
    }

    // Reset upload button
    if (uploadButton) {
      uploadButton.disabled = true;
      uploadButton.style.opacity = '0.5';
      uploadButton.textContent = 'Upload';
    }

    // Reset preview and placeholder
    if (preview && placeholder) {
      preview.style.display = 'none';
      preview.querySelector('p').textContent = '';
      placeholder.style.display = 'block';
    }
  }

  function backToUserType(currentModalId) {
    document.getElementById(currentModalId).style.display = 'none';
    document.getElementById('userTypeModal').style.display = 'block';
  }

  function closeModal(modalId) {
    document.getElementById(modalId).style.display = 'none';
    
    // Reset upload field and UI if closing the upload modal
    if (modalId === 'uploadAvatarModal') {
      // Reset file input
      const fileInput = document.getElementById('avatarFile');
      if (fileInput) {
        fileInput.value = '';
      }

      // Reset upload button
      const uploadButton = document.getElementById('uploadButton');
      if (uploadButton) {
        uploadButton.disabled = true;
        uploadButton.style.opacity = '0.5';
        uploadButton.textContent = 'Upload';
      }

      // Reset preview and placeholder
      const preview = document.getElementById('filePreview');
      const placeholder = document.getElementById('uploadPlaceholder');
      if (preview && placeholder) {
        preview.style.display = 'none';
        preview.querySelector('p').textContent = '';
        placeholder.style.display = 'block';
      }
    }
  }

  function handleFileSelect(input) {
    const file = input.files[0];
    const uploadButton = document.getElementById('uploadButton');
    const placeholder = document.getElementById('uploadPlaceholder');
    const preview = document.getElementById('filePreview');
    
    if (file) {
      // Show file name and enable upload button
      preview.style.display = 'block';
      preview.querySelector('p').textContent = `Selected: ${file.name}`;
      placeholder.style.display = 'none';
      uploadButton.style.opacity = '1';
      uploadButton.disabled = false;
    } else {
      // Reset to initial state
      preview.style.display = 'none';
      placeholder.style.display = 'block';
      uploadButton.style.opacity = '0.5';
      uploadButton.disabled = true;
    }
  }

  function uploadAvatar() {
    const fileInput = document.getElementById('avatarFile');
    const file = fileInput.files[0];
    const uploadButton = document.getElementById('uploadButton');
    
    if (file) {
      // Show loading state
      uploadButton.disabled = true;
      uploadButton.textContent = 'Uploading...';

      // Create FormData
      const formData = new FormData();
      formData.append('file', file);

      // Log the file being sent
      console.log('Sending file:', {
        name: file.name,
        size: file.size,
        type: file.type
      });

      // Send to local backend
      fetch('http://localhost:8000/upload', {
        method: 'POST',
        body: formData
      })
      .then(response => {
        console.log('Response status:', response.status);
        if (!response.ok) {
          throw new Error(`Upload failed: ${response.status}`);
        }
        return response.json();
      })
      .then(data => {
        console.log('Upload successful:', data);
        
        // Dispatch custom event to notify model viewer
        const event = new CustomEvent('modelUploaded', {
          detail: {
            timestamp: new Date().getTime(),
            filename: 'avatar.fbx'
          }
        });
        window.dispatchEvent(event);

        // Close upload modal
        closeModal('uploadAvatarModal');
        alert('File uploaded successfully! Model viewer will update automatically.');
      })
      .catch(error => {
        console.error('Upload error:', error);
        alert('Upload failed: ' + error.message);
      })
      .finally(() => {
        // Reset button state
        uploadButton.disabled = false;
        uploadButton.textContent = 'Upload';
      });
    }
  }

  // Close modal when clicking outside
  window.onclick = function(event) {
    if (event.target.className === 'modal') {
      event.target.style.display = 'none';
    }
  }
</script>

{% schema %}
{
  "name": "Try On Button",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Try-on and find your size"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    }
  ]
}
{% endschema %} 