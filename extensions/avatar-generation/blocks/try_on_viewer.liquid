<div class="try-on-viewer-container">
  <div class="viewer-tabs">
    <button class="tab active" id="try-on-tab">Try-on</button>
    <button class="tab" id="body-dim-tab">Body Measurements</button>
  </div>

  <div class="viewer-layout active" id="try-on-view">
    <!-- Left Panel -->
    <div class="measurement-panel">
      <!-- Size Recommendation with yellow highlight -->
      <div class="size-recommendation">
        <div class="recommendation-label">Recommended size</div>
        <div class="size-selector">
          <div class="size-options">
            <!-- We'll update this span with the recommended size after fetching from /get-sizing -->
            <span class="size-option selected">N/A</span>
          </div>
        </div>
      </div>

      <!-- Fit Preference with slider -->
      <div class="fit-preference" style="display: none;">
        <div class="preference-header">
          <span>Fit preference</span>
          <button class="info-icon">ⓘ</button>
        </div>
        <div class="slider-container">
          <div class="slider-labels">
            <span>Tight</span>
            <span>Fitted</span>
            <span>Loose</span>
          </div>
          <input type="range" min="0" max="100" value="50" class="fit-slider">
          <div class="slider-track"></div>
        </div>
      </div>

      <!-- Dimensions -->
      <div class="dimensions" style="margin-bottom: 30px;">
        <div class="dimensions-header">
          <span>Dimensions</span>
        </div>
        <div class="measurements-list">
          <div class="measurement-item">
            <span class="measure-label">Height</span>
            <div class="measure-value">
              <span class="status">N/A</span>
            </div>
          </div>
          <div class="measurement-item">
            <span class="measure-label">Chest</span>
            <div class="measure-value">
              <span class="status">N/A</span>
            </div>
          </div>
          <div class="measurement-item">
            <span class="measure-label">Waist</span>
            <div class="measure-value">
              <span class="status">N/A</span>
            </div>
          </div>
          <div class="measurement-item">
            <span class="measure-label">Hip</span>
            <div class="measure-value">
              <span class="status">N/A</span>
            </div>
          </div>
          <div class="measurement-item">
            <span class="measure-label">Shoulder Width</span>
            <div class="measure-value">
              <span class="status">N/A</span>
            </div>
          </div>
          <div class="measurement-item">
            <span class="measure-label">Sleeve Length</span>
            <div class="measure-value">
              <span class="status">N/A</span>
            </div>
          </div>
          <div class="measurement-item">
            <span class="measure-label">Inseam</span>
            <div class="measure-value">
              <span class="status">N/A</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Panel - Video Viewer -->
    <div class="model-viewer-panel">
      <!-- Video Container -->
      <div class="video-container">
        <!-- Label for 3D Viewer -->
        <div class="viewer-label">3D Viewer</div>
        
        <!-- 3D Model Viewer (Initially Hidden) -->
        <model-viewer
          id="apose-viewer"
          style="display: none; width: 100%; height: 100%"
          auto-rotate
          camera-controls
        >
        </model-viewer>

        <video id="product-video" controls muted playsinline style="display: none;">
          <source src="" type="video/mp4">
          Your browser does not support the video tag.
        </video>

        <!-- Simulation Unavailable Message (initially hidden) -->
        <div id="simulationUnavailable" class="message-box" style="display: none;">
          <div class="message-content">
            <div class="message-title">Select an Animation</div>
            <div class="message-subtitle">Click one of the animations below to view</div>
            <div class="message-arrow">↓</div>
          </div>
        </div>

        <!-- Loading Indicator -->
        <div id="loadingIndicator" class="loading-spinner" style="display:none;">
          <div class="spinner"></div>
          <div class="loading-text">Loading animation...</div>
        </div>

        <!-- Animation unavailable after failure -->
        <div id="no-animation-message" class="message-box" style="display: none;">Animation Unavailable</div>
      </div>

      <!-- Animation Controls -->
      <div class="animation-controls">
        <!-- Animation Title Above -->
        <div class="animation-title">Animations</div>

        <!-- Scrolling Row with Left/Right Arrows -->
        <div class="animation-scroller">
          <!-- button class="arrow-button" id="prevAnimation">‹</button -->

          <div class="animation-buttons-container">
            <button class="animation-button" data-animation="apose">Standing</button>
            <button class="animation-button" data-animation="walking">Walking</button>
            <button class="animation-button" data-animation="jumping">Jumping</button>
            <button class="animation-button" data-animation="sideflip">Sideflip</button>
          </div>

          <!-- button class="arrow-button" id="nextAnimation">›</button -->
        </div>
      </div>

      <!-- Copyright BELOW the animation controls -->
      <div class="copyright">© Simflection</div>
    </div>
  </div>


  
  <!-- Body Dimensions View (Initially Hidden) -->
  <div class="viewer-layout" id="body-dim-view" style="display: none;">
    <!-- Left Panel - Body Dimensions -->
    <div class="measurement-panel">
        <div class="dimensions">
            <div class="dimensions-header">
                <span>Body Dimensions</span>
            </div>
            <div class="measurements-list">
                <div class="measurement-item">
                    <span class="measure-label">Height</span>
                    <div class="measure-value"><span class="status">N/A</span></div>
                </div>
                <div class="measurement-item">
                    <span class="measure-label">Bust</span>
                    <div class="measure-value"><span class="status">N/A</span></div>
                </div>
                <div class="measurement-item">
                    <span class="measure-label">Waist</span>
                    <div class="measure-value"><span class="status">N/A</span></div>
                </div>
                <div class="measurement-item">
                    <span class="measure-label">Hip</span>
                    <div class="measure-value"><span class="status">N/A</span></div>
                </div>
                <div class="measurement-item">
                    <span class="measure-label">Shoulder Width</span>
                    <div class="measure-value"><span class="status">N/A</span></div>
                </div>
                <div class="measurement-item">
                    <span class="measure-label">Sleeve Length</span>
                    <div class="measure-value"><span class="status">N/A</span></div>
                </div>
                <div class="measurement-item">
                    <span class="measure-label">Inseam</span>
                    <div class="measure-value"><span class="status">N/A</span></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Panel - 3D Model Viewer -->
    <div class="model-viewer-panel">
        <div class="model-viewer-container">
            <model-viewer
                id="body-dim-viewer"
                style="width: 100%; height: 100%"
                auto-rotate
                camera-controls>
            </model-viewer>
            
            <!-- Loading Indicator for Body Measurements -->
            <div id="bodyDimLoadingIndicator" class="loading-spinner" style="display:none;">
                <div class="spinner"></div>
                <div class="loading-text">Loading 3D model...</div>
            </div>
        </div>
    </div>
  </div>



</div>

