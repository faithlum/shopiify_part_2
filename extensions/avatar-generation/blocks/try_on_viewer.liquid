<div class="try-on-viewer-container">
  <div class="viewer-tabs">
    <button class="tab active">Try-on</button>
    <button class="tab">Body Measurements</button>
  </div>
  
  <div class="viewer-layout">
    <!-- Left Panel -->
    <div class="measurement-panel">
      <!-- Size Recommendation with yellow highlight -->
      <div class="size-recommendation">
        <div class="recommendation-label">Recommended size</div>
        <div class="size-selector">
          <div class="size-options">
            <!-- We'll update this span with the recommended size after fetching from /get-sizing -->
            <span class="size-option selected">N/A</span>
          </div>
        </div>
      </div>

      <!-- Fit Preference with slider -->
      <div class="fit-preference" style="display: none;">
        <div class="preference-header">
          <span>Fit preference</span>
          <button class="info-icon">ⓘ</button>
        </div>
        <div class="slider-container">
          <div class="slider-labels">
            <span>Tight</span>
            <span>Fitted</span>
            <span>Loose</span>
          </div>
          <input type="range" min="0" max="100" value="50" class="fit-slider">
          <div class="slider-track"></div>
        </div>
      </div>

      <!-- Dimensions -->
      <div class="dimensions" style="margin-bottom: 30px;">
        <div class="dimensions-header">
          <span>Dimensions</span>
        </div>
        <div class="measurements-list">
          <div class="measurement-item">
            <span class="measure-label">Bust</span>
            <div class="measure-value">
              <span class="status">N/A</span>
            </div>
          </div>
          <div class="measurement-item">
            <span class="measure-label">Sleeve length</span>
            <div class="measure-value">
              <span class="status">N/A</span>
            </div>
          </div>
          <div class="measurement-item">
            <span class="measure-label">Shoulder width</span>
            <div class="measure-value">
              <span class="status">N/A</span>
            </div>
          </div>
          <div class="measurement-item">
            <span class="measure-label">Waist</span>
            <div class="measure-value">
              <span class="status">N/A</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Material Composition -->
      <div class="material-composition">
        <div class="composition-header">
          <span>Material Composition</span>
        </div>
        <div class="materials-list">
          <div class="material-item">
            <span class="material-value">N/A</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Panel - Video Viewer -->
    <div class="model-viewer-panel">
      <!-- Video Container -->
        <!-- Video Container -->
        <div class="video-container">
          <!-- 3D Model Viewer (Initially Hidden) -->
          <model-viewer 
            id="apose-viewer"
            style="diplay: none; width: 100%; height: 100%"
            auto-rotate 
            camera-controls
            exposure="0.5" 
            shadow-intensity="0.8">
          </model-viewer>
          

          <video id="product-video" controls autoplay style="display: none;">
            <source src="" type="video/mp4">
            Your browser does not support the video tag.
          </video>
          
          <!-- Simulation Unavailable Message (shown initially) -->
          <div id="simulationUnavailable" class="message-box">
            Simulation Unavailable
          </div>

          <!-- Loading Indicator -->
          <div id="loadingIndicator" class="loading-spinner" style="display:none;">
            <div class="spinner"></div>
            <div class="loading-text">Loading animation...</div>
          </div>

          <!-- Animation unavailable after failure -->
          <div id="no-animation-message" class="message-box" style="display: none;">
            Animation Unavailable
          </div>
        </div>



      <!-- Animation Controls -->
      <div class="animation-controls">
        <!-- Animation Title Above -->
        <div class="animation-title">Animations</div>

        <!-- Scrolling Row with Left/Right Arrows -->
        <div class="animation-scroller">
          <!--button class="arrow-button" id="prevAnimation">‹</button-->
          
          <div class="animation-buttons-container">
            <button class="animation-button" data-animation="apose">Standing</button>
            <button class="animation-button" data-animation="walking">Walking</button>
            <button class="animation-button" data-animation="jumping">Jumping</button>
            <button class="animation-button" data-animation="gymnastics">Gymnastics</button>
          </div>

          <!--button class="arrow-button" id="nextAnimation">›</button-->
        </div>
      </div>

      <!-- Copyright BELOW the animation controls -->
      <div class="copyright">
        © Simflection
      </div>
    </div>
  </div>
</div>

<script type="module" src="https://unpkg.com/@google/model-viewer@latest"></script>

<style>
  .try-on-viewer-container {
    width: 100%;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .viewer-tabs {
    display: flex;
    gap: 2px;
    margin-bottom: -1px;
  }

  .tab {
    padding: 10px 20px;
    border: none;
    background: #f5f5f5;
    cursor: pointer;
  }

  .tab.active {
    background: white;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
  }

  .viewer-layout {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 20px;
    background: white;
    min-height: 600px;
    width: 100%;
  }

  .measurement-panel {
    padding: 20px;
    border-right: 1px solid #eee;
    background: white;
  }


  /* Size Recommendation Styles */
  .size-recommendation {
    background: #FFF9E6;
    padding: 15px;
    border-radius: 4px;
    margin-bottom: 30px;
  }

  .recommendation-label {
    font-size: 14px;
    margin-bottom: 10px;
  }

  .size-selector {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
  }

  .size-options {
    display: flex;
    gap: 20px;
  }

  .size-option {
    font-size: 16px;
    cursor: pointer;
  }

  .size-option.selected {
    font-weight: 600;
  }


  /* Video Container */
  .video-container {
    width: 100%;
    height: 450px; /* fixed height to ensure no layout shifts */
    position: relative; /* important for positioning children absolutely */
    display: flex;
    justify-content: center;
    align-items: center;
  }

  #product-video {
    width: 90%;
    max-width: 700px;
    height: 100%;
    object-fit: contain;
  }

  .message-box {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    color: #888;
    background-color: #f9f9f9;
  }

  .loading-spinner {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.8);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .spinner {
    width: 40px;
    height: 40px;
    border: 4px solid #f3f3f3;
    border-top: 4px solid #000;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin-bottom: 10px;
  }

  .loading-text {
    font-size: 14px;
    color: #333;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  /* Fix the position for animation bar and copyright */
  .animation-controls {
    margin-top: 20px;
    background-color: white;
    padding: 10px;
    position: absolute;
    bottom: 40px; /* fix position, adjust as needed */
    left: 50%;
    transform: translateX(-50%);
  }

  .copyright {
    position: absolute;
    bottom: 10px; /* adjust as needed */
    right: 10px;
  }

  /* Message when animation is unavailable */
  #no-animation-message {
    text-align: center;
    color: red;
  }


  /* Update the CSS for measurement items */
  .measurement-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
    padding: 8px 0;
    border-bottom: 1px solid #eee;
  }

  .measure-label {
    font-size: 14px;
    color: #333;
  }

  .measure-value {
    display: flex;
    align-items: center;
  }

  .status {
    font-size: 12px;
    font-weight: 500;
  }

  .just-right { color: #4CAF50; }
  .long { color: #F44336; }
  .little-tight { color: #FF9800; }

  /* Animation Controls */
  /* The overall container for the animation UI */
.animation-controls {
  margin-top: 20px;
  background-color: white;
  padding: 10px;
  display: flex;
  flex-direction: column; /* Title on top, scroller below */
  align-items: flex-start;
  gap: 10px;
}

/* The text "Animations" on its own line above the carousel */
.animation-title {
  font-size: 16px;
  font-weight: 600;
}

/* The row containing the arrow buttons and the scrolling container */
.animation-scroller {
  display: flex;
  align-items: center;
  gap: 10px;
}

/* Container that holds all the animation buttons in one line */
.animation-buttons-container {
  display: flex;
  flex-wrap: nowrap; /* Prevents buttons from wrapping */
  align-items: center;
  gap: 10px;
  overflow: hidden;  /* Hide overflow for a neat carousel effect */
  max-width: 600px;  /* Adjust as needed */
}

/* Left/Right arrow buttons */
.arrow-button {
  background: none;
  border: none;
  font-size: 24px;
  cursor: pointer;
  color: #333;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow-button:hover {
  background: #f0f0f0;
  border-radius: 4px;
}

/* Your existing .animation-button styles (light blue) remain unchanged */
.animation-button {
  background-color: #ADD8E6;
  color: black;
  border: none;
  padding: 8px 16px;
  margin: 5px;
  border-radius: 4px;
  cursor: pointer;
  font-size: 14px;
}


  /* Example arrow hover effect (optional) */
  .arrow-button:hover {
    background: #f0f0f0;
    border-radius: 4px;
  }


</style>

<script>
  console.log('🔵 VIEWER SCRIPT - START LOADING');
  document.addEventListener('DOMContentLoaded', function() {
    console.log('🔵 VIEWER SCRIPT - DOMContentLoaded fired');

    // 🚨 Reset avatarChosen to false on page load
    localStorage.setItem('avatarChosen', 'false');

    // For animation scroller
    const container = document.querySelector('.animation-buttons-container');
    const prevBtn = document.getElementById('prevAnimation');
    const nextBtn = document.getElementById('nextAnimation');

    if (container && prevBtn && nextBtn) {
      prevBtn.addEventListener('click', () => {
        container.scrollBy({ left: -100, behavior: 'smooth' });
      });
      nextBtn.addEventListener('click', () => {
        container.scrollBy({ left: 100, behavior: 'smooth' });
      });
    }

    // A reusable function that fetches sizing and updates the UI
    async function updateSizingFromBackend() {
      console.log('[Viewer] updateSizingFromBackend triggered');
      try {
        const response = await fetch('http://localhost:8000/get-sizing');
        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }

        // Read recommended size and comment from headers
        const recommendedSize = response.headers.get('X-Recommended-Size');
        const sizeComment = response.headers.get('X-Size-Comment');
        console.log("[Viewer] Recommended size:", recommendedSize);

        if (recommendedSize && recommendedSize !== 'None') {
          // Update the recommended size in the UI
          const sizeElement = document.querySelector('.size-option.selected');
          if (sizeElement) {
            sizeElement.textContent = recommendedSize;
          }

          // If there's a comment with dimension details, parse and display them
          if (sizeComment && sizeComment !== 'None') {
            const measurements = sizeComment.split(';').map(m => m.trim());
            const measurementsList = document.querySelector('.measurements-list');
            measurementsList.innerHTML = '';

            measurements.forEach(measurement => {
              const words = measurement.split(' ');
              const dimensionName = words[0];
              const status = words.slice(2).join(' ').toUpperCase();

              let statusClass = '';
              if (status.includes('JUST RIGHT')) statusClass = 'just-right';
              else if (status.includes('LONG')) statusClass = 'long';
              else if (status.includes('TIGHT')) statusClass = 'little-tight';

              const measurementItem = `
                <div class="measurement-item">
                  <span class="measure-label">${dimensionName}</span>
                  <div class="measure-value">
                    <span class="status ${statusClass}">${status}</span>
                  </div>
                </div>
              `;
              measurementsList.innerHTML += measurementItem;
            });
          }
        } else {
          console.log('[Viewer] No recommended size returned');
        }
      } catch (error) {
        console.error('[Viewer] Error fetching sizing:', error);
        // Optionally reset to N/A
        const sizeElement = document.querySelector('.size-option.selected');
        if (sizeElement) {
          sizeElement.textContent = 'N/A';
        }
      }
    }

    // 1) Listen for a custom event "avatar-chosen"
    document.addEventListener('avatar-chosen', function() {
      console.log('[Viewer] avatar-chosen event received, calling updateSizingFromBackend()');
      updateSizingFromBackend();
    });

    // 2) Animation button handling
    function sendAnimationToBackend(animation) {
      console.log('[Viewer] Sending selected animation to backend:', animation);
      var productTitle = "{{ product.title }}";
      var productId = "{{ product.id }}";

      console.log(productTitle);
      console.log(productId);

      return fetch('http://localhost:8000/selected-animation', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          animation: animation,
          productTitle: productTitle,
          productId: productId
        })
      })
      .then(response => {
        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }
        return response.json();
      })
      .then(data => {
        console.log('[Viewer] Animation sent successfully, data:', data);
        // data.output_url is what we'll use to set the video source
        return data.output_url;
      })
      .catch(error => {
        console.error('[Viewer] Error sending animation to backend:', error);
        throw error; // re-throw so the caller can handle it
      });
    }


    // Handle click on animation buttons
    const animationButtons = document.querySelectorAll('.animation-button');
    const videoElement = document.getElementById('product-video');
    const noAnimationMessage = document.getElementById('no-animation-message');

    // Handle click on animation buttons
    animationButtons.forEach(button => {
      button.addEventListener('click', function() {
        const selectedAnimation = this.dataset.animation;
        const loadingIndicator = document.getElementById('loadingIndicator');
        const videoElement = document.getElementById('product-video');
        const noAnimationMessage = document.getElementById('no-animation-message');
        const simulationUnavailable = document.getElementById('simulationUnavailable');
        const modelViewer = document.getElementById('apose-viewer'); // Get Model Viewer

        // 🚨 Stronger check for avatar selection
        const avatarChosen = localStorage.getItem('avatarChosen');
        console.log("Avatar chosen state:", avatarChosen); // Debugging log
        if (avatarChosen !== "true") {
          alert("Please click the Try-on button first to select default avatar or upload an avatar before playing animations.");
          return; // 🚫 Stop execution here, do not proceed
        }

        // Start Loading: show loader, hide other messages and video
        loadingIndicator.style.display = 'flex';
        simulationUnavailable.style.display = 'none';
        noAnimationMessage.style.display = 'none';
        videoElement.style.display = 'none';
        modelViewer.style.display = 'none'; // Hide model viewer


        // Fetch animation from backend
        sendAnimationToBackend(selectedAnimation)
          .then(outputUrl => {
            if (outputUrl) {
              if (selectedAnimation === "apose") {
                loadingIndicator.style.display = 'none';
                simulationUnavailable.style.display = 'none';
                noAnimationMessage.style.display = 'none';
                modelViewer.src = outputUrl; // Set Model Viewer source
                modelViewer.style.display = 'block'; // Show 3D Viewer
              } else {
                loadingIndicator.style.display = 'none';
                simulationUnavailable.style.display = 'none';
                noAnimationMessage.style.display = 'none';
                videoElement.src = outputUrl;
                videoElement.style.display = 'block';
                videoElement.play();
                videoElement.loop = true;
              }
            } else {
              loadingIndicator.style.display = 'none';
              simulationUnavailable.style.display = 'none';
              noAnimationMessage.style.display = 'flex';
            }
          })
          .catch(error => {
            console.error('[Viewer] Error:', error);
            loadingIndicator.style.display = 'none';
            simulationUnavailable.style.display = 'none';
            noAnimationMessage.style.display = 'flex';
          });
      });
    });



  });
</script>

{% schema %}
{
  "name": "Try-On Viewer",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "viewer_title",
      "label": "Viewer Title",
      "default": "Virtual Try-On"
    },
    {
      "type": "checkbox",
      "id": "enable_ar",
      "label": "Enable AR View",
      "default": true
    }
  ]
}
{% endschema %}
