  "name": "Try-On Viewer",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "viewer_title",
      "label": "Viewer Title",
      "default": "Virtual Try-On"
    },
    {
      "type": "checkbox",
      "id": "enable_ar",
      "label": "Enable AR View",
      "default": true
    }
  ]
}
