<script>
  console.log('🔵 VIEWER SCRIPT - START LOADING');
  document.addEventListener('DOMContentLoaded', function () {
    console.log('🔵 VIEWER SCRIPT - DOMContentLoaded fired');

    // 🚨 Reset avatarChosen to false on page load
    localStorage.setItem('avatarChosen', 'false');


    const tryOnTab = document.getElementById("try-on-tab");
    const bodyDimTab = document.getElementById("body-dim-tab");
    const tryOnView = document.getElementById("try-on-view");
    const bodyDimView = document.getElementById("body-dim-view");

    function switchTab(activeTab) {
      if (activeTab === "try-on") {
        tryOnView.style.display = '';
        bodyDimView.style.display = '';
        tryOnView.classList.add("active");
        bodyDimView.classList.remove("active");
        tryOnTab.classList.add("active");
        bodyDimTab.classList.remove("active");
      } else {
        tryOnView.style.display = '';
        bodyDimView.style.display = '';
        tryOnView.classList.remove("active");
        bodyDimView.classList.add("active");
        bodyDimTab.classList.add("active");
        tryOnTab.classList.remove("active");
      }
    }

    tryOnTab.addEventListener("click", () => switchTab("try-on"));
    bodyDimTab.addEventListener("click", () => switchTab("body-dim"));

    // A reusable function that fetches sizing and updates the UI
    async function updateSizingFromBackend() {
      console.log('[Viewer] updateSizingFromBackend triggered');
      try {
        const response = await fetch('https://api.simflection.tech/get-sizing');
        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }

        // Read recommended size and comment from headers
        const recommendedSize = response.headers.get('X-Recommended-Size');
        const sizeComment = response.headers.get('X-Size-Comment');
        console.log('[Viewer] Recommended size:', recommendedSize);

        if (recommendedSize && recommendedSize !== 'None') {
          // Update the recommended size in the UI
          const sizeElement = document.querySelector('.size-option.selected');
          if (sizeElement) {
            sizeElement.textContent = recommendedSize;
          }

          // If there's a comment with dimension details, parse and display them
          if (sizeComment && sizeComment !== 'None') {
            const measurements = sizeComment.split(';').map((m) => m.trim());
            const measurementsList = document.querySelector('.measurements-list');
            measurementsList.innerHTML = '';

            measurements.forEach((measurement) => {
              const words = measurement.split(' ');
              const dimensionName = words[0];
              const status = words.slice(2).join(' ').toUpperCase();

              let statusClass = '';
              if (status.includes('JUST RIGHT')) statusClass = 'just-right';
              else if (status.includes('LONG')) statusClass = 'long';
              else if (status.includes('TIGHT')) statusClass = 'little-tight';

              const measurementItem = `
                <div class="measurement-item">
                  <span class="measure-label">${dimensionName}</span>
                  <div class="measure-value">
                    <span class="status ${statusClass}">${status}</span>
                  </div>
                </div>
              `;
              measurementsList.innerHTML += measurementItem;
            });
          }
        } else {
          console.log('[Viewer] No recommended size returned');
        }
      } catch (error) {
        console.error('[Viewer] Error fetching sizing:', error);
        // Optionally reset to N/A
        const sizeElement = document.querySelector('.size-option.selected');
        if (sizeElement) {
          sizeElement.textContent = 'N/A';
        }
      }
    }

    // A reusable function that fetches body dim + get glb and updates the UI
    async function updateBodyDim() {
      console.log('[Viewer] updateBodyDim triggered');
      try {
        // Show loading indicator
        const loadingIndicator = document.getElementById('bodyDimLoadingIndicator');
        if (loadingIndicator) {
          loadingIndicator.style.display = 'flex';
        }

        const response = await fetch('https://api.simflection.tech/get-body-dim-and-model');
        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }

        const data = await response.json();

        console.log(data)

        if (data.error) {
          console.error("❌ API Error:", data.error);
          return;
        }

        const body_dimensions = data.body_dim;
        const glb_url = data.glb_url;
        console.log('[Viewer] Body dimensions:', body_dimensions);
        console.log('[Viewer] glb url:', glb_url);
        
        // Update 3D Model Viewer
        const modelViewer = document.getElementById("body-dim-viewer");
        if (glb_url) {
          modelViewer.src = glb_url;
          // Add load event listener to hide loading indicator when model is ready
          modelViewer.addEventListener('load', () => {
            if (loadingIndicator) {
              loadingIndicator.style.display = 'none';
            }
          }, { once: true });
        }

        // Update measurements display
        const dimensions = {
          height: body_dimensions.height,
          bust: body_dimensions.bust,
          waist: body_dimensions.waist,
          hip: body_dimensions.hips,
          shoulderWidth: body_dimensions.shoulderWidth,
          sleeveLength: body_dimensions.sleeveLength,
          inseam: body_dimensions.inseam
        };

        // Update measurement values
        Object.entries(dimensions).forEach(([key, value]) => {
          document.querySelectorAll("#body-dim-view .measurement-item").forEach((item) => {
            const label = item.querySelector(".measure-label");
            const status = item.querySelector(".measure-value .status");

            if (label && status) {
              const labelText = label.textContent.replace(" ", "").trim().toLowerCase();
              const keyText = key.replace(/_/g, " ").toLowerCase();

              if (labelText.includes(keyText)) {
                status.textContent = value ? `${parseFloat(value).toFixed(3)} m` : "N/A";
              }
            }
          });
        });

      } catch (error) {
        console.error('[Viewer] Error fetching get body dim and model:', error);
        // Hide loading indicator on error
        const loadingIndicator = document.getElementById('bodyDimLoadingIndicator');
        if (loadingIndicator) {
          loadingIndicator.style.display = 'none';
        }
      }
    }

    // 1) Listen for a custom event "avatar-chosen"
    document.addEventListener('avatar-chosen', function () {
      console.log('[Viewer] avatar-chosen event received, calling updateSizingFromBackend() and updateBodyDim()');
      updateSizingFromBackend();
      updateBodyDim();
      
      // Update the message to show animation selection prompt
      const simulationUnavailable = document.getElementById('simulationUnavailable');
      simulationUnavailable.style.display = 'flex';
      const videoElement = document.getElementById('product-video');
      videoElement.style.display = 'none';
      const modelViewer = document.getElementById('apose-viewer');
      modelViewer.style.display = 'none';
    });

    // 2) Animation button handling
    function sendAnimationToBackend(animation) {
      console.log('[Viewer] Sending selected animation to backend:', animation);
      var productTitle = '{{ product.title }}';
      var productId = '{{ product.id }}';

      console.log(productTitle);
      console.log(productId);

      return fetch('https://api.simflection.tech/selected-animation', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          animation: animation,
          productTitle: productTitle,
          productId: productId,
        }),
      })
        .then((response) => {
          if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
          }
          return response.json();
        })
        .then((data) => {
          console.log('[Viewer] Animation sent successfully, data:', data);
          // data.output_url is what we'll use to set the video source
          return data.output_url;
        })
        .catch((error) => {
          console.error('[Viewer] Error sending animation to backend:', error);
          throw error; // re-throw so the caller can handle it
        });
    }

    // Handle click on animation buttons
    const animationButtons = document.querySelectorAll('.animation-button');
    const videoElement = document.getElementById('product-video');
    const noAnimationMessage = document.getElementById('no-animation-message');

    // Handle click on animation buttons
    animationButtons.forEach((button) => {
      button.addEventListener('click', function () {
        const selectedAnimation = this.dataset.animation;
        const loadingIndicator = document.getElementById('loadingIndicator');
        const videoElement = document.getElementById('product-video');
        const noAnimationMessage = document.getElementById('no-animation-message');
        const simulationUnavailable = document.getElementById('simulationUnavailable');
        const modelViewer = document.getElementById('apose-viewer'); // Get Model Viewer

        // 🚨 Stronger check for avatar selection
        const avatarChosen = localStorage.getItem('avatarChosen');
        console.log('Avatar chosen state:', avatarChosen); // Debugging log
        if (avatarChosen !== 'true') {
          alert(
            'Please click the Try-on button first to select default avatar or upload an avatar before playing animations.'
          );
          return; // 🚫 Stop execution here, do not proceed
        }

        // Start Loading: show loader, hide other messages and video
        loadingIndicator.style.display = 'flex';
        simulationUnavailable.style.display = 'none';
        noAnimationMessage.style.display = 'none';
        videoElement.style.display = 'none';
        modelViewer.style.display = 'none'; // Hide model viewer

        // Fetch animation from backend
        sendAnimationToBackend(selectedAnimation)
          .then((outputUrl) => {
            console.log("outputUrl");
            console.log(outputUrl);
            if (outputUrl) {
              if (selectedAnimation === 'apose') {
                loadingIndicator.style.display = 'none';
                simulationUnavailable.style.display = 'none';
                noAnimationMessage.style.display = 'none';
                modelViewer.src = outputUrl; // Set Model Viewer source
                modelViewer.style.display = 'block'; // Show 3D Viewer
              } else {
                loadingIndicator.style.display = 'none';
                simulationUnavailable.style.display = 'none';
                noAnimationMessage.style.display = 'none';
                videoElement.src = outputUrl;
                videoElement.style.display = 'block';
                videoElement.play();
                videoElement.loop = true;
              }
            } else {
              loadingIndicator.style.display = 'none';
              simulationUnavailable.style.display = 'none';
              noAnimationMessage.style.display = 'flex';
            }
          })
          .catch((error) => {
            console.error('[Viewer] Error:', error);
            loadingIndicator.style.display = 'none';
            simulationUnavailable.style.display = 'none';
            noAnimationMessage.style.display = 'flex';
          });
      });
    });

    // Add scroll indicator logic
    const animationContainer = document.querySelector('.animation-buttons-container');
    if (animationContainer) {
      // Check if scrolling is needed
      function checkScroll() {
        const isScrollable = animationContainer.scrollWidth > animationContainer.clientWidth;
        const isScrolledToEnd = animationContainer.scrollLeft + animationContainer.clientWidth >= animationContainer.scrollWidth - 10;
        
        if (!isScrollable || isScrolledToEnd) {
          animationContainer.classList.add('scrolled-to-end');
        } else {
          animationContainer.classList.remove('scrolled-to-end');
        }
      }

      // Check on load and whenever content changes
      checkScroll();
      window.addEventListener('resize', checkScroll);
      
      // Check while scrolling
      animationContainer.addEventListener('scroll', checkScroll);

      // Add touch indicator for mobile
      let touchStartX = 0;
      animationContainer.addEventListener('touchstart', (e) => {
        touchStartX = e.touches[0].clientX;
      });

      animationContainer.addEventListener('touchmove', (e) => {
        const touchEndX = e.touches[0].clientX;
        const deltaX = touchStartX - touchEndX;
        
        if (Math.abs(deltaX) > 5) {
          animationContainer.style.scrollBehavior = 'smooth';
        }
      });
    }
  });
</script>

